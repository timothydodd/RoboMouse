<Project Sdk="Microsoft.NET.Sdk">

  <!-- LocalSystem Windows service: watches the active desktop/session and owns the control pipe the
       normal-user app connects to. Native AOT, no networking. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RoboMouse.Service</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <AssemblyName>RoboMouse.Service</AssemblyName>
    <Version>1.1.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoboMouse.Contracts\RoboMouse.Contracts.csproj" />
  </ItemGroup>

</Project>
