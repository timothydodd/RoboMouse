<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RoboMouse.App.ViewModels"
        xmlns:views="using:RoboMouse.App.Views"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="RoboMouse.App.Views.ToastWindow"
        x:DataType="vm:ToastViewModel"
        Title="{Binding Title}"
        Width="380" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowDecorations="None" WindowStartupLocation="Manual"
        Background="Transparent" TransparencyLevelHint="Transparent"
        Icon="/Assets/app.ico">

  <Border Classes="toast" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Message}"
          AutomationProperties.LiveSetting="Polite">
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
      <ic:SymbolIcon Grid.RowSpan="2" Symbol="{Binding Icon}" FontSize="22" Margin="0,1,12,0" VerticalAlignment="Top"
                     Foreground="{Binding Tone, Converter={x:Static views:StatusToneToBrushConverter.Instance}}" />
      <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="body-strong" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="2" Classes="toast-close" Command="{Binding CloseCommand}"
              AutomationProperties.Name="Close notification" ToolTip.Tip="Close">
        <ic:SymbolIcon Symbol="Dismiss" FontSize="12" />
      </Button>
      <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Message}" Classes="caption" Margin="0,4,8,0" />
      <ItemsControl Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Actions}"
                    IsVisible="{Binding HasActions}" Margin="0,12,8,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToastActionViewModel">
            <Button Content="{Binding Label}" Command="{Binding RunCommand}" Classes.accent="{Binding IsPrimary}" MinWidth="80"
                    HorizontalContentAlignment="Center" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>

</Window>
