<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoboMouse.App.ViewModels"
             xmlns:views="using:RoboMouse.App.Views"
             x:Class="RoboMouse.App.Views.LayoutPageView"
             x:DataType="vm:LayoutPageViewModel">

  <Grid Margin="{StaticResource AppPagePadding}" RowDefinitions="Auto,Auto,*" MaxWidth="860">
    <TextBlock Classes="title" Text="Layout" />
    <TextBlock Grid.Row="1" Classes="caption" Margin="0,0,0,12"
               Text="Drag each screen to where it sits on your desk. Every monitor of another PC is its own screen, so you can split them up or change their order, and several PCs can share one side. A screen settles against the nearest edge and never overlaps another; the mouse crosses wherever two screens touch. Faded screens are offline or disabled. From the keyboard: Tab to a screen, then use the arrow keys (Shift for small steps). Nothing changes until you click Save." />
    <Border Grid.Row="2" Classes="card panel">
      <views:ScreenLayoutControl x:Name="Canvas" Layout="{Binding}" />
    </Border>
  </Grid>

</UserControl>
