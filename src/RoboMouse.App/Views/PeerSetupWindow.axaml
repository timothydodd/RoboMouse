<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RoboMouse.App.ViewModels"
        xmlns:views="using:RoboMouse.App.Views"
        x:Class="RoboMouse.App.Views.PeerSetupWindow"
        x:DataType="vm:PeerSetupViewModel"
        Title="{Binding Title}"
        Width="480" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app.ico"
        Background="{DynamicResource AppWindowBackgroundBrush}">

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="footer">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="accent" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
      </StackPanel>
    </Border>

    <StackPanel Margin="24,20,24,24" Spacing="14">
      <TextBlock Classes="subtitle" Text="{Binding Title}" />

      <StackPanel Spacing="6">
        <TextBlock Text="Name" />
        <TextBox Text="{Binding Name}" PlaceholderText="How this machine is shown in the list" AutomationProperties.Name="Name" />
      </StackPanel>

      <Grid ColumnDefinitions="*,12,Auto,12,Auto">
        <StackPanel Spacing="6">
          <TextBlock Text="Address" />
          <TextBox Text="{Binding Address}" PlaceholderText="IP address or host name" AutomationProperties.Name="Address" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="6">
          <TextBlock Text="Port" />
          <NumericUpDown Value="{Binding Port}" Minimum="1024" Maximum="65535" Increment="1" FormatString="0" ShowButtonSpinner="False" Width="120"
                         AutomationProperties.Name="Port" />
        </StackPanel>
        <Button Grid.Column="4" Content="Test" Command="{Binding TestCommand}" IsVisible="{Binding CanTest}"
                AutomationProperties.Name="Test the connection"
                VerticalAlignment="Bottom" MinWidth="72" HorizontalContentAlignment="Center" />
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanTest}">
        <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding IsTesting}" VerticalAlignment="Center" />
        <TextBlock Classes="caption" Text="{Binding TestResult}" AutomationProperties.LiveSetting="Polite"
                   Foreground="{Binding TestTone, Converter={x:Static views:StatusToneToBrushConverter.Instance}}"
                   MaxWidth="400" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Position" />
        <ComboBox ItemsSource="{Binding Positions}" SelectedItem="{Binding SelectedPosition}" Width="220" AutomationProperties.Name="Position" />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Offset along the shared edge" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="X" VerticalAlignment="Center" Classes="muted" />
          <NumericUpDown Value="{Binding OffsetX}" Minimum="-10000" Maximum="10000" Increment="1" FormatString="0" ShowButtonSpinner="False" Width="130"
                         AutomationProperties.Name="Horizontal offset" AutomationProperties.HelpText="Pixels to shift the other screen along a top or bottom edge" />
          <TextBlock Text="Y" VerticalAlignment="Center" Classes="muted" Margin="8,0,0,0" />
          <NumericUpDown Value="{Binding OffsetY}" Minimum="-10000" Maximum="10000" Increment="1" FormatString="0" ShowButtonSpinner="False" Width="130"
                         AutomationProperties.Name="Vertical offset" AutomationProperties.HelpText="Pixels to shift the other screen along a left or right edge" />
        </StackPanel>
        <TextBlock Classes="caption" Text="Pixels to shift the other screen. Easier to set by dragging on the Layout page." />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Jump hotkey" />
        <views:HotkeyBox Hotkey="{Binding JumpHotkey}" AllowClear="True" Width="220" HorizontalAlignment="Left"
                         AutomationProperties.Name="Jump hotkey"
                         AutomationProperties.HelpText="Moves the cursor straight onto this PC's screen" />
        <TextBlock Classes="caption" Text="Moves the cursor straight onto this PC's screen. Backspace clears it." />
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="Share the clipboard" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="Copied text, images and files go both ways with this PC. Off, it gets nothing copied here and nothing copied there reaches this PC." />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShareClipboard}" VerticalAlignment="Center" Margin="16,0,0,0"
                      AutomationProperties.Name="Share the clipboard with this PC" />
      </Grid>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="Enabled" />
          <TextBlock Classes="caption" Text="A disabled peer keeps its settings but is never connected to and cannot take control of this screen." />
        </StackPanel>
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="16,0,0,0"
                      AutomationProperties.Name="Enabled" AutomationProperties.HelpText="A disabled peer keeps its settings but is never connected to" />
      </Grid>

      <StackPanel Spacing="2">
        <TextBlock Text="Identity" />
        <SelectableTextBlock Classes="caption code" Text="{Binding IdentityText}" AutomationProperties.Name="Identity fingerprint" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="Matches the fingerprint in Settings, Network on that PC once the two have paired." />
      </StackPanel>
    </StackPanel>
  </DockPanel>

</Window>
