<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RoboMouse.App.Views.MessageDialog"
        Width="440" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app.ico"
        Background="{DynamicResource AppWindowBackgroundBrush}">

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="footer">
      <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" />
    </Border>

    <StackPanel Margin="24,20,24,24" Spacing="10">
      <TextBlock x:Name="TitleText" Classes="subtitle" />
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    </StackPanel>
  </DockPanel>

</Window>
