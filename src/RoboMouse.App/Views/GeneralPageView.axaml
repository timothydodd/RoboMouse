<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RoboMouse.App.ViewModels"
             xmlns:views="using:RoboMouse.App.Views"
             x:Class="RoboMouse.App.Views.GeneralPageView"
             x:DataType="vm:GeneralPageViewModel">

  <ScrollViewer>
    <StackPanel Margin="{StaticResource AppPagePadding}" MaxWidth="860" HorizontalAlignment="Stretch">
      <TextBlock Classes="title" Text="General" />

      <TextBlock Classes="section first" Text="This computer" />
      <views:SettingCard Header="Machine name" Description="How this computer appears on the other machines.">
        <TextBox Text="{Binding MachineName}" Width="260" />
      </views:SettingCard>
      <views:SettingCard Header="Start with Windows" Description="{Binding StartupDescription}">
        <ToggleSwitch IsChecked="{Binding StartWithWindows}" />
      </views:SettingCard>
      <views:SettingCard Header="Start minimized to the tray" Description="When off, Settings opens each time RoboMouse starts. While no peers are set up, the pairing wizard opens instead.">
        <ToggleSwitch IsChecked="{Binding StartMinimized}" />
      </views:SettingCard>

      <TextBlock Classes="section" Text="Moving between screens" />
      <views:SettingCard Header="Toggle hotkey"
                         Description="Releases control of another screen if you are stuck there; otherwise turns sharing on or off. Click the box and press the new combination.">
        <views:HotkeyBox Hotkey="{Binding ToggleHotkey}" Width="220" AutomationProperties.Name="Toggle hotkey" />
      </views:SettingCard>
      <views:SettingCard Header="Wrap around"
                         Description="Pushing through an edge with no screen beyond it comes out on the far side of the row or column, so screens in a row form a loop.">
        <ToggleSwitch IsChecked="{Binding WrapAround}" />
      </views:SettingCard>

      <TextBlock Classes="section" Text="Clipboard" />
      <views:SettingCard Header="Share the clipboard" Description="What you copy on one machine can be pasted on the others. Choose what is shared below.">
        <ToggleSwitch IsChecked="{Binding ShareClipboard}" />
      </views:SettingCard>
      <StackPanel IsEnabled="{Binding ShareClipboard}">
        <views:SettingCard Classes="nested" Header="Text">
          <ToggleSwitch IsChecked="{Binding SyncText}" />
        </views:SettingCard>
        <views:SettingCard Classes="nested" Header="Images" Description="Screenshots and pictures copied from apps.">
          <ToggleSwitch IsChecked="{Binding SyncImages}" />
        </views:SettingCard>
        <views:SettingCard Classes="nested" Header="Files"
                           Description="Paste them in Explorer on the other machine. Files transfer only when you paste, straight from the machine you copied them on.">
          <ToggleSwitch IsChecked="{Binding ShareFiles}" />
        </views:SettingCard>
      </StackPanel>

      <TextBlock Classes="section" Text="Follow the controlling PC" />
      <TextBlock Classes="caption" Margin="4,0,0,8" TextWrapping="Wrap"
                 Text="Turn these on at the PC being controlled. The controlling PC is the one that last moved the mouse onto this screen." />
      <views:SettingCard Header="Stay awake with it"
                         Description="While its display is on, this PC and its display stay on too. When its display turns off or it goes to sleep, this display turns off and the usual sleep timers apply again.">
        <ToggleSwitch IsChecked="{Binding FollowHostPower}" AutomationProperties.Name="Stay awake with the controlling PC" />
      </views:SettingCard>
      <views:SettingCard Header="Lock with it"
                         Description="When it locks, this PC locks too. Only a paired PC is followed.">
        <ToggleSwitch IsChecked="{Binding LockWithHost}" AutomationProperties.Name="Lock with the controlling PC" />
      </views:SettingCard>
      <views:SettingCard Header="Screen saver with it"
                         Description="When its screen saver starts, start this one's too, unless this PC was used in the last minute.">
        <ToggleSwitch IsChecked="{Binding ScreensaverWithHost}" AutomationProperties.Name="Start the screen saver with the controlling PC" />
      </views:SettingCard>

      <TextBlock Classes="caption" Margin="4,16,0,0" TextWrapping="Wrap"
                 Text="When a switch happens, more hotkeys, the clipboard size limit, waking sleeping PCs and more are on the Advanced page." />
    </StackPanel>
  </ScrollViewer>

</UserControl>
